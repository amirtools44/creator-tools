<script>
const titleInput=document.getElementById('titleInput');
const charCount=document.getElementById('charCount');
titleInput.addEventListener('input',()=>{charCount.textContent=titleInput.value.length+(titleInput.value.length===1?' character':' characters');});
function checkTitle(){
 const title=titleInput.value.trim();
 const result=document.getElementById('titleResult');
 if(!title){result.textContent='Please enter a YouTube video title first.';return;}
 const length=title.length;
 let suggestion;
 if(length<30){suggestion='Your title is quite short. Consider adding useful context if it helps viewers understand the video.';}
 else if(length<=65){suggestion='Good concise length. Check that the title clearly describes your video.';}
 else{suggestion='Your title is quite long. Consider shortening it while keeping the important information.';}
 result.innerHTML='<div class="score">'+length+' characters</div><p>'+suggestion+'</p>';
}
</script>
